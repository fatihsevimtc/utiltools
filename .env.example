# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# Web3Forms access key (used by the "Suggest a tool" form)
# Get a free key at https://web3forms.com — enter your email, they send it instantly.
# Free tier: 250 submissions/month, no account needed.
VITE_WEB3FORMS_KEY=YOUR_ACCESS_KEY
